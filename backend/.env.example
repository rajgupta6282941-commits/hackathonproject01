# Render supplies PORT automatically. This value is for local development only.
PORT=3001
NODE_ENV=production
# Required for Atlas-backed persistence. Never use an in-memory fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/vikral

# Comma-separated exact browser origins. Add the Vercel production URL and any
# explicitly approved preview URL; do not use a wildcard in production.
CORS_ALLOWED_ORIGINS=https://your-vikral.vercel.app

# Optional AI context provider. Keep the real key in backend environment only.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_MS=5000
